      "flame_risk": "warning + de_escalation_message",
      "active_conflict": "warning_or_mute + notify_admin"
    }
  },

  "contextualModeration": {
    "enabled": true,

    "requireContextForAction": true,
    "tolerateLightProfanity": true,

    "allowedColloquialExpressions": [
      "ma che cazzo dici",
      "che cazzo vuoi dire",
      "non ha senso quello che dici",
      "sei serio?"
    ],

    "rules": [
      "Non prendere decisioni da singoli messaggi isolati",
      "Valuta sempre la conversazione tra utenti specifici",
      "Identifica se esiste un conflitto bidirezionale o solo sfogo unilaterale",
      "Intervieni solo se esiste escalation tra due utenti o gruppo",
      "Non punire linguaggio emotivo non diretto",
      "Considera contesto sociale del messaggio",
      "Privilegia sempre la de-escalation prima della punizione"
